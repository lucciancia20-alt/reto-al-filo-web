rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'lciancia1972@gmail.com',
          'lucianociancia86@gmail.com'
        ];
    }

    function hasNonEmptyString(data, field) {
      return field in data
        && data[field] is string
        && data[field].trim().size() > 0;
    }

    function isValidRegistrationCreate(data) {
      return data.keys().hasAll([
          'code',
          'distance',
          'fullName',
          'dni',
          'birthDate',
          'phone',
          'email',
          'city',
          'emergencyContactName',
          'emergencyContactPhone',
          'receiptUrl',
          'status',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'distance', 'priceSnapshot', 'isLocalResident', 'discountPercentApplied',
          'originalPrice', 'finalAmount', 'fullName', 'dni', 'birthDate', 'gender',
          'phone', 'email', 'city', 'team', 'shirtSize', 'bloodType',
          'emergencyContactName', 'emergencyContactPhone', 'medicalNotes', 'acceptedTerms',
          'receiptUrl', 'receiptPublicId', 'receiptFormat', 'status', 'assignedBib',
          'createdAt', 'updatedAt'
        ])
        && hasNonEmptyString(data, 'code')
        && data.code.matches('^RAF-([0-9]{5}|[A-Z0-9]{8})$')
        && data.distance in ['27K', '13K']
        && (!('isLocalResident' in data) || data.isLocalResident is bool)
        && (!('discountPercentApplied' in data) || (data.discountPercentApplied is int && data.discountPercentApplied >= 0 && data.discountPercentApplied <= 100))
        && (!('originalPrice' in data) || data.originalPrice is string)
        && (!('finalAmount' in data) || data.finalAmount is string)
        && hasNonEmptyString(data, 'fullName')
        && hasNonEmptyString(data, 'dni')
        && hasNonEmptyString(data, 'birthDate')
        && hasNonEmptyString(data, 'phone')
        && hasNonEmptyString(data, 'email')
        && hasNonEmptyString(data, 'city')
        && hasNonEmptyString(data, 'emergencyContactName')
        && hasNonEmptyString(data, 'emergencyContactPhone')
        && hasNonEmptyString(data, 'receiptUrl')
        && data.status == 'pendiente'
        && (!('assignedBib' in data) || data.assignedBib == '')
        && data.createdAt is int
        && data.updatedAt is int;
    }

    match /settings/raceConfig {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Control de sesión única activa del panel admin (1 doc, solo admins)
    match /settings/adminSession {
      allow read, write: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow create: if isValidRegistrationCreate(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Proyección pública: la crea/actualiza la Cloud Function (Admin SDK, ignora reglas)
    // y el panel admin. El público solo puede leer un documento por ID (sin list).
    match /publicStatus/{lookupId} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }
    // Contadores agregados: los mantiene la Cloud Function y el panel admin.
    match /stats/summary {
      allow read, write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
